{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KevinToodlepoot/vgc-usage-stats/schemas/spreads.schema.json",
  "title": "vgc-usage-stats spreads file (one species)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "month", "format", "cutoff", "name", "id", "total_weight", "min_share", "dropped", "spreads", "by_nature"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "format": { "type": "string", "minLength": 1 },
    "cutoff": { "type": "integer", "minimum": 0 },
    "name": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+$" },
    "total_weight": { "type": "number", "minimum": 0 },
    "min_share": { "type": "number", "minimum": 0, "maximum": 1 },
    "dropped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "weight"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 }
      }
    },
    "spreads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spread", "nature", "sp", "weight", "share"],
        "properties": {
          "spread": { "type": "string", "pattern": "^[A-Z][a-z]+:\\d+/\\d+/\\d+/\\d+/\\d+/\\d+$" },
          "nature": { "type": "string", "pattern": "^[A-Z][a-z]+$" },
          "sp": { "$ref": "#/$defs/statPoints" },
          "weight": { "type": "number", "minimum": 0 },
          "share": { "type": "number", "minimum": 0, "maximum": 1 },
          "stats": { "$ref": "#/$defs/finalStats" }
        }
      }
    },
    "by_nature": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][a-z]+$" },
      "additionalProperties": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
    }
  },
  "$defs": {
    "statPoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hp", "atk", "def", "spa", "spd", "spe"],
      "properties": {
        "hp": { "type": "integer", "minimum": 0, "maximum": 32 },
        "atk": { "type": "integer", "minimum": 0, "maximum": 32 },
        "def": { "type": "integer", "minimum": 0, "maximum": 32 },
        "spa": { "type": "integer", "minimum": 0, "maximum": 32 },
        "spd": { "type": "integer", "minimum": 0, "maximum": 32 },
        "spe": { "type": "integer", "minimum": 0, "maximum": 32 }
      }
    },
    "finalStats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hp", "atk", "def", "spa", "spd", "spe"],
      "properties": {
        "hp": { "type": "integer", "minimum": 1 },
        "atk": { "type": "integer", "minimum": 1 },
        "def": { "type": "integer", "minimum": 1 },
        "spa": { "type": "integer", "minimum": 1 },
        "spd": { "type": "integer", "minimum": 1 },
        "spe": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
