{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kkopczynski/vgc-usage-stats/schemas/index.schema.json",
  "title": "vgc-usage-stats index file (one format × cutoff × month)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "month", "format", "cutoff", "source", "info", "species"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "format": { "type": "string", "minLength": 1 },
    "cutoff": { "type": "integer", "minimum": 0 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "path", "sha256", "bytes"],
      "properties": {
        "url": { "type": ["string", "null"] },
        "path": { "type": ["string", "null"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "info": { "type": "object" },
    "species": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "id", "file", "total_weight", "raw_count", "usage", "n_spreads"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "pattern": "^[a-z0-9]+$" },
          "file": { "type": "string", "pattern": "^spreads/[a-z0-9]+\\.json$" },
          "total_weight": { "type": "number", "minimum": 0 },
          "raw_count": { "type": "integer", "minimum": 0 },
          "usage": { "type": "number", "minimum": 0 },
          "n_spreads": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
