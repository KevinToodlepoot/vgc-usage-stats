{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KevinToodlepoot/vgc-usage-stats/schemas/summary.schema.json",
  "title": "vgc-usage-stats summary file (all species)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "month", "format", "cutoff", "species"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "format": { "type": "string", "minLength": 1 },
    "cutoff": { "type": "integer", "minimum": 0 },
    "species": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "id", "total_weight", "nature_share", "concentration", "sp"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "pattern": "^[a-z0-9]+$" },
          "total_weight": { "type": "number", "exclusiveMinimum": 0 },
          "nature_share": {
            "type": "object",
            "propertyNames": { "pattern": "^[A-Z][a-z]+$" },
            "additionalProperties": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          },
          "concentration": {
            "type": "object",
            "propertyNames": { "pattern": "^[A-Z][a-z]+$" },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["top1", "top5"],
              "properties": {
                "top1": { "type": "number", "minimum": 0, "maximum": 1 },
                "top5": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "sp": { "$ref": "#/$defs/statSummary" },
          "stats": { "$ref": "#/$defs/statSummary" }
        }
      }
    }
  },
  "$defs": {
    "statSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "by_nature"],
      "properties": {
        "overall": { "$ref": "#/$defs/statBlock" },
        "by_nature": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Z][a-z]+$" },
          "additionalProperties": { "$ref": "#/$defs/statBlock" }
        }
      }
    },
    "statBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hp", "atk", "def", "spa", "spd", "spe"],
      "properties": {
        "hp": { "$ref": "#/$defs/dist" },
        "atk": { "$ref": "#/$defs/dist" },
        "def": { "$ref": "#/$defs/dist" },
        "spa": { "$ref": "#/$defs/dist" },
        "spd": { "$ref": "#/$defs/dist" },
        "spe": { "$ref": "#/$defs/dist" }
      }
    },
    "dist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution", "p5", "p10", "p25", "p50", "p75", "p90", "p95", "min", "max", "mean"],
      "properties": {
        "distribution": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "weight", "cum"],
            "properties": {
              "value": { "type": "integer", "minimum": 0 },
              "weight": { "type": "number", "exclusiveMinimum": 0 },
              "cum": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
            }
          }
        },
        "p5": { "type": "integer" }, "p10": { "type": "integer" }, "p25": { "type": "integer" },
        "p50": { "type": "integer" }, "p75": { "type": "integer" }, "p90": { "type": "integer" },
        "p95": { "type": "integer" },
        "min": { "type": "integer" },
        "max": { "type": "integer" },
        "mean": { "type": "number" }
      }
    }
  }
}
